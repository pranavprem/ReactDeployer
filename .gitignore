# Local .terraform directories
**/.terraform/*

# State is remote for the app stack and local for bootstrap. Never commit it.
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Crash logs
crash.log
crash.*.log

# Variable files can carry account-specific values. The example is safe to commit.
*.tfvars
*.tfvars.json
!terraform.tfvars.example

# Backend settings are account-specific. Copy backend.hcl.example to backend.hcl.
backend.hcl

# Local overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Plan files
*.tfplan
*tfplan*

# CLI config
.terraformrc
terraform.rc

# The dependency lock file is committed on purpose so provider versions stay pinned.
# Do not add .terraform.lock.hcl here.

# SSH material, if someone saves the generated key next to the config
*.pem
*.key

# TFLint plugin cache
.tflint.d/
